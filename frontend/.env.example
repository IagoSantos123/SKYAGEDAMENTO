# Chave da API da Groq, usada futuramente por src/services/groqService.js
# Nunca commite sua chave real — copie este arquivo para .env e preencha localmente.
VITE_GROQ_API_KEY=

# Credenciais usadas SOMENTE pelas funções serverless em /api (login no
# LucroMais). NÃO prefixar com VITE_ — variáveis VITE_* são embutidas no
# bundle do navegador e ficariam visíveis para qualquer visitante do site.
# Configure estes valores como "Environment Variables" do projeto na Vercel
# (nunca em um arquivo .env commitado).
LUCROMAIS_BASE_URL=https://lucromais-backend-mssolucoes.vercel.app/api
LUCROMAIS_EMAIL=
LUCROMAIS_SENHA=
